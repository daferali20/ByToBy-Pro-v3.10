TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DISCORD_WEBHOOK_URL=

# Cloud Services
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=bytoby-data

GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=bytoby

# Security
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
PASSWORD_SALT_ROUNDS=12
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60  # seconds

# Feature Flags
ENABLE_REAL_TIME=True
ENABLE_AI_SCANNER=True
ENABLE_EXPLOSION_DETECTOR=True
ENABLE_SMART_MONEY_TRACKING=True
ENABLE_NEWS_ANALYSIS=True
ENABLE_BACKTESTING=True
ENABLE_SOCIAL_SENTIMENT=True
ENABLE_PAPER_TRADING=True

# Performance Settings
CACHE_TTL_SECONDS=300
MAX_CACHE_SIZE=1000
ASYNC_WORKERS=4
BATCH_SIZE=100
REFRESH_RATE=30  # seconds

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/bytoby.log
LOG_FORMAT=json
SENTRY_DSN=

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TIMEZONE=UTC

# Default Settings
DEFAULT_CURRENCY=USD
DEFAULT_TIMEFRAME=1D
DEFAULT_SYMBOLS=AAPL,GOOGL,MSFT,TSLA,AMZN
MAX_SYMBOLS_TRACKED=100
MAX_ALERTS_PER_USER=50

# Testing
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/bytoby_test
TEST_MODE=False
